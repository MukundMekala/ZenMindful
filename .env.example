# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/mindease_db

# AI Configuration (Optional - app works without these)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Session Security
SESSION_SECRET=your_secure_session_secret_here

# Replit Configuration (Auto-configured in Replit environment)
REPL_ID=your_repl_id
REPLIT_DOMAINS=your_repl_domain.repl.co

# Firebase Configuration (Optional - for enhanced auth)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_APP_ID=your_firebase_app_id